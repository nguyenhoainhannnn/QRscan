{
  "name": "momo-stream-alert-backend",
  "version": "1.0.0",
  "description": "MoMo Stream Alert – Backend API + WebSocket + TTS proxy",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node node_modules/nodemon/bin/nodemon.js src/server.js",
    "test": "node node_modules/jest/bin/jest.js --forceExit",
    "test:parser": "node node_modules/jest/bin/jest.js tests/parser.test.js --verbose --forceExit",
    "test:webhook": "node scripts/test-webhook.js",
    "test:webhook:v": "node scripts/test-webhook.js --verbose",
    "test:fifo": "node scripts/test-webhook.js --fifo",
    "test:overlay": "node scripts/test-webhook.js --host http://localhost:3000",
    "test:acceptance": "node scripts/run-acceptance-tests.js"
  },
  "keywords": [
    "momo",
    "donation",
    "obs",
    "stream",
    "alert",
    "webhook"
  ],
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
