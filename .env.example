# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# Dùng cho kết nối trực tiếp (ngoài Docker). Khi chạy trong Docker,
# docker-compose sẽ tự override bằng biến nội bộ.
POSTGRES_DB=momo_alert
POSTGRES_USER=momo_user
POSTGRES_PASSWORD=strongpassword
POSTGRES_PORT=5432
DATABASE_URL=postgres://momo_user:strongpassword@localhost:5432/momo_alert

# ── Bảo mật Webhook ──────────────────────────────────────────────────────────
# Chuỗi bí mật dùng để tính chữ ký HMAC-SHA256 cho mỗi request từ App Android.
# Thay bằng chuỗi ngẫu nhiên dài ≥ 32 ký tự trước khi deploy.
WEBHOOK_SECRET=change_me_to_a_long_random_secret_32chars

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# Mật khẩu đăng nhập trang quản trị (hash bcrypt khuyến nghị ở production).
ADMIN_PASSWORD=admin_secure_password_here

# ── OBS Overlay ───────────────────────────────────────────────────────────────
# Token bảo vệ endpoint WebSocket và trang OBS overlay.
OBS_OVERLAY_TOKEN=obs_token_change_me_too

# ── Node.js ───────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
