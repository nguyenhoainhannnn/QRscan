<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MoMoStreamAlert" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/momo_pink</item>
        <item name="colorPrimaryVariant">@color/momo_pink_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/momo_pink_light</item>
        <item name="colorSecondaryVariant">@color/momo_pink_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
